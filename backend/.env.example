# ── Flask / JWT Secret Keys ──
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# ── WSL Scan Mount Path ──
# Specifies the absolute path to mount the temporary directory for ClamAV scans
HOST_SCAN_DIR=your_host_scan_dir_here


# ── VirusTotal API Key ──
VT_API_KEY=your_virustotal_api_key_here

# ── AlienVault OTX API Key ──
OTX_API_KEY=your_alienvault_otx_api_key_here

# ── Post-Quantum Cryptography ──
# Set to 'true' when liboqs-python is installed (Linux/WSL required)
# When false: AES-256-GCM + KMS envelope encryption only (still production-grade)
# When true: Adds ML-KEM-768 (Kyber) + ML-DSA-65 (Dilithium) quantum resistance
PQC_ENABLED=true

# ── Docker Configuration (Layer 3 & 4) ──
# ClamAV Docker image (persistent clamd daemon on TCP 3310)
CLAMAV_DOCKER_IMAGE=clamav/clamav:stable
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Sandbox Docker image (ephemeral containers)
SANDBOX_DOCKER_IMAGE=stackdrive-sandbox:latest
SANDBOX_TIMEOUT=10

# ── StackDrive Bot (Gemini API) ──
# Get your API key from: https://aistudio.google.com/apikey
# When not set, the bot uses built-in static responses (still functional)
GEMINI_API_KEY=your_gemini_api_key_here
